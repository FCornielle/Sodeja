# Local Postgres+PostGIS (docker-compose.yml). Free/local only — see
# docs/SODEJA_ARCHITECTURE.md "Infrastructure posture". Copy to .env and adjust
# if needed; .env itself is gitignored.
POSTGRES_USER=sodeja
POSTGRES_PASSWORD=sodeja_dev
POSTGRES_DB=sodeja
POSTGRES_PORT=5432

DATABASE_URL=postgres://sodeja:sodeja_dev@localhost:5432/sodeja

# --- apps/api (B-3: provider abstraction + server-side proxy) ---
PORT=3000

# Provider selection (packages/providers/src/registry.ts). Switching a
# provider is always just changing these values, never a code change.
TILE_PROVIDER=pmtiles-local
TILES_LOCAL_DIR=./data/tiles
GEOCODING_PROVIDER=mock
POI_PROVIDER=overture-local

# Per-user / per-IP rate limits enforced by apps/api's RateLimitGuard.
RATE_LIMIT_PER_USER_PER_MIN=60
RATE_LIMIT_PER_IP_PER_MIN=120

# Resilience (timeout, retry-with-backoff, circuit breaker) for every
# provider call — see @sodeja/providers's resilience.ts.
PROVIDER_TIMEOUT_MS=5000
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_MS=200
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_RESET_TIMEOUT_MS=30000

# Internal cost-estimation / billing-alert thresholds only (local logic and
# logs, never a call to a cloud billing API — see billingAlerts.ts).
BILLING_ALERT_WARN_USD=10
BILLING_ALERT_CRITICAL_USD=50

# Credentialed providers (Google/Mapbox/MapTiler). Leave EMPTY until the
# product owner explicitly approves a paid provider — every adapter reports
# NOT_CONFIGURED / "unconfigured" and makes no network call without these set
# (see SODEJA_ARCHITECTURE.md "Infrastructure posture"). Never commit real
# values here; this file is the template, not actual configuration.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
MAPTILER_API_KEY=

# --- reports / services/pdf-worker (B-19: Module 13 PDF export) ---
# Local directory the filesystem storage driver (services/pdf-worker/src/
# storage.ts) writes rendered PDFs under. STORAGE_DRIVER is not yet a real
# seam here (only filesystem is implemented) — this is the equivalent of the
# providers table's "Storage" row's MVP default, scoped to reports only.
REPORTS_STORAGE_DIR=./data/reports

# How long a single Chromium render step (page load or PDF export) may run
# before services/pdf-worker/src/render.ts's local timeout guard aborts it
# and the report is marked 'failed' rather than left 'rendering' forever.
REPORT_RENDER_TIMEOUT_MS=30000

# --- services/ingestion (B-4: footprints, B-6: admin geometry + census) ---
# All free/open data sources; no key required. Every source's URL is
# overridable so a mirror or dataset update never needs a code change — see
# services/ingestion/README.md.
MS_GLOBALML_DATASET_LINKS_URL=https://minedbuildings.z5.web.core.windows.net/global-buildings/dataset-links.csv
MS_GLOBALML_REGION=DominicanRepublic

# Google does not publish one stable bulk-download manifest URL per country
# (unlike Microsoft's dataset-links.csv above). Comma-separated gzipped CSV
# shard URLs for Open Buildings V3 (Dominican Republic S2 cells) obtained
# from https://sites.research.google/gr/open-buildings/#download. Leave
# empty to skip this source — it is a cross-check/gap-fill, not the primary
# footprint source, so the ingest:footprints job logs a warning and
# continues with MS GlobalML alone.
OPEN_BUILDINGS_SOURCE_URLS=

OCHA_ADMIN_ZIP_URL=https://data.humdata.org/dataset/1b26ea94-4d28-4167-9209-4984ab087973/resource/66c7a7c9-5be1-4b1a-8b5a-a559e0c970a8/download/dom_admin_boundaries.geojson.zip

# ONE Censo 2022 has no API (REDATAM, manual extraction only — see
# services/ingestion/README.md's "Census population (B-6, part 2)" section
# for the extraction steps and required CSV shape). No default: the
# ingest:census job fails clearly if this is unset rather than silently
# doing nothing.
CENSUS_EXTRACT_CSV_PATH=
