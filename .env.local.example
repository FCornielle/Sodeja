# Esodeja — plantilla de configuracion.
#
# Copia este fichero a `.env.local` y rellena los valores.
# `.env.local` esta en .gitignore y NUNCA se commitea.
#
# =============================================================================
# GOOGLE MAPS PLATFORM
# =============================================================================
#
# Hacen falta DOS claves distintas, creadas en el mismo proyecto de Cloud pero
# con restricciones opuestas. No uses la misma para ambas cosas.
#
# -----------------------------------------------------------------------------
# 1) Clave de NAVEGADOR — solo Maps JavaScript API
# -----------------------------------------------------------------------------
# Es visible en el codigo del cliente por diseno: Maps JS la necesita ahi.
# Lo que la protege es la restriccion por referrer, no el secreto.
#
# En Cloud Console > Credenciales > esta clave:
#   - Restriccion de aplicacion: "Sitios web (referentes HTTP)"
#       http://localhost:3000/*
#       https://TU-DOMINIO/*      (cuando publiques)
#   - Restriccion de API: SOLO "Maps JavaScript API"
#
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

# -----------------------------------------------------------------------------
# 2) Clave de SERVIDOR — Places, Routes, Geocoding, Static, Street View
# -----------------------------------------------------------------------------
# Esta NO lleva prefijo NEXT_PUBLIC_ y no debe llegar nunca al navegador.
# Solo la usan los Route Handlers bajo app/api/.
#
# En Cloud Console > Credenciales > esta clave:
#   - Restriccion de aplicacion: "Ninguna" (las llamadas salen del servidor)
#   - Restriccion de API: SOLO este conjunto exacto
#       Places API (New)
#       Routes API
#       Geocoding API
#       Maps Static API
#       Street View Static API
#
GOOGLE_MAPS_SERVER_KEY=

# ID del proyecto de Google Cloud. Solo se usa para mostrarlo en la pantalla de
# diagnostico y para que los mensajes de error digan contra que proyecto se
# esta facturando.
GOOGLE_CLOUD_PROJECT_ID=

# =============================================================================
# PRESUPUESTO DE API
# =============================================================================
#
# Guardarrail duro, aplicado en el servidor por lib/google/meter.ts.
# Al 80% del presupuesto la UI avisa. Al 100% se BLOQUEAN las llamadas de tier
# Pro y Enterprise y la app pasa a modo degradado.
#
# El credito recurrente de Maps es de $200/mes y no caduca. Un estudio completo
# cuesta ~$0.40-0.55, asi que 50 USD/mes son ~100 estudios: mas que suficiente
# para uso personal, y deja margen bajo el credito.
MONTHLY_BUDGET_USD=50

# =============================================================================
# BASE DE DATOS
# =============================================================================
#
# SQLite en fichero. No hay Docker ni servidor que arrancar.
# El fichero .db esta en .gitignore: contiene coordenadas cacheadas de Google,
# sujetas al limite de retencion de 30 dias de los Terminos de Servicio.
DATABASE_PATH=./data/esodeja.db
